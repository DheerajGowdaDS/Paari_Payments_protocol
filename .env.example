# Paari sandbox configuration. Never commit real credentials.
PAARI_ENV=sandbox
DATABASE_URL=sqlite:///./paari.db
PAARI_ADMIN_API_KEY=<generate-a-random-admin-key>
PAARI_SIGNING_KEY_PATH=<path-to-paari-private-signing-key-held-in-a-secret-store>
PAARI_REQUIRE_USER_MANDATE=0

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_<your-test-key-id>
RAZORPAY_KEY_SECRET=<your-test-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-test-webhook-secret>
RAZORPAY_API_BASE=https://api.razorpay.com/v1

# Protocol-only autonomous conformance (NO real money; in-memory reference provider):
# PAARI_MODE=autonomous
# PAARI_AGENTIC_PROVIDER=app.providers.reference_autonomous:ReferenceAutonomousProvider

# Optional: provider-native autonomous settlement.
# Do NOT set these until the provider has enabled/documented a server-to-server
# mandate/debit capability for your account. Paari will refuse to claim
# autonomous settlement without an explicit capability attestation.
# PAARI_AGENTIC_PROVIDER=app.providers.razorpay_agentic:RazorpayAgenticProvider
# RAZORPAY_AGENTIC_CAPABILITY_CONFIRMED=1
# RAZORPAY_AGENTIC_AUTHORIZE_PATH=<provider-documented-authorize-path>
# RAZORPAY_AGENTIC_PAYMENT_PATH=<provider-documented-payment-read-path>
# RAZORPAY_AGENTIC_CAPTURE_PATH=<provider-documented-capture-path>
# RAZORPAY_AGENTIC_VALIDATE_PATH=<provider-documented-mandate-status-path>
# RAZORPAY_AGENTIC_TOKEN_LIST_PATH=<provider-documented-token-list-path>
# RAZORPAY_AGENTIC_REVOKE_PATH=<provider-documented-revoke-path>

# Optional remote LLM router
BYNARA_API_BASE=https://router.bynara.id/v1
BYNARA_API_KEY=<your-key>
BYNARA_MODEL=space-bunny-alpha-bynara
