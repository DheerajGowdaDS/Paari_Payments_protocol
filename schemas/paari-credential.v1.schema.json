{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paari.example/schemas/paari-credential.v1.schema.json",
  "title": "Paari Credential JWT v1.0",
  "type": "object",
  "required": ["iss", "aud", "sub", "jti", "iat", "exp", "typ", "protocol_version", "capabilities", "payment_limit_minor_units", "currency"],
  "properties": {
    "iss": {"const": "paari"},
    "aud": {"const": "paari-payment"},
    "sub": {"type": "string", "minLength": 1},
    "jti": {"type": "string", "minLength": 1},
    "iat": {"type": "integer", "minimum": 0},
    "exp": {"type": "integer", "minimum": 1},
    "typ": {"const": "paari_credential"},
    "protocol_version": {"const": "1.0"},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "payment_limit_minor_units": {"type": "integer", "minimum": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
  },
  "additionalProperties": false,
  "examples": [
    {
      "iss": "paari",
      "aud": "paari-payment",
      "sub": "agent-123",
      "jti": "cred-789",
      "iat": 1726680000,
      "exp": 1758216000,
      "typ": "paari_credential",
      "protocol_version": "1.0",
      "capabilities": ["payment.create"],
      "payment_limit_minor_units": 500000,
      "currency": "INR"
    }
  ]
}
