{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paari.example/schemas/paari-proof-bundle.v1.schema.json",
  "title": "Paari Proof Bundle v1.0",
  "type": "object",
  "required": ["protocol", "protocol_version", "bundle_id", "transaction_id", "created_at", "artifacts"],
  "properties": {
    "protocol": {"const": "paari"},
    "protocol_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "transaction_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "object",
      "required": ["discovery", "parent_trust", "delegation", "agent_identity", "agent_card", "credential", "authentication", "payment_intent", "governance_decision", "bounded_authorization", "payment_execution", "payment_result", "audit_record", "revocation"],
      "properties": {
        "discovery": {"type": "object"},
        "parent_trust": {"type": "object"},
        "delegation": {"type": "object"},
        "agent_identity": {"type": "object"},
        "agent_card": {"type": "object"},
        "credential": {"type": "object"},
        "authentication": {"type": "object"},
        "payment_intent": {"type": "object"},
        "governance_decision": {"type": "object"},
        "bounded_authorization": {"type": ["object", "null"]},
        "payment_execution": {"type": ["object", "null"]},
        "payment_result": {"type": ["object", "null"]},
        "audit_record": {"type": "object"},
        "revocation": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "protocol": "paari",
      "protocol_version": "1.0",
      "bundle_id": "bundle-c81d",
      "transaction_id": "TXN-proof-f45a2f45",
      "created_at": "2026-09-19T00:00:00Z",
      "artifacts": {
        "discovery": {},
        "parent_trust": {},
        "delegation": {},
        "agent_identity": {},
        "agent_card": {},
        "credential": {},
        "authentication": {},
        "payment_intent": {},
        "governance_decision": {},
        "bounded_authorization": {},
        "payment_execution": {},
        "payment_result": {},
        "audit_record": {},
        "revocation": {}
      }
    }
  ]
}
