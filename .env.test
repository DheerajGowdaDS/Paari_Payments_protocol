# Paari TEST configuration - loaded by tests/conftest.py, never by the app.
#
# This file exists so the suite's governance posture is a versioned decision
# rather than an accident of whatever the operator's shell exported. It sets the
# baseline the fixture applies to every test; individual tests that need the
# autonomous posture say so explicitly with monkeypatch.
#
# Deliberately absent: DATABASE_URL. That variable names the DEPLOYMENT's
# database, and a test configuration file must not claim it. The disposable test
# target is PAARI_DATABASE_URL here, or TEST_DATABASE_URL from the environment,
# which takes precedence.
PAARI_ENV=test
PAARI_MODE=standard
PAARI_REQUIRE_USER_MANDATE=0
PAARI_REQUIRE_SIGNED_MANDATE=0
PAARI_DATABASE_URL=sqlite:///./.phase5_test.db
